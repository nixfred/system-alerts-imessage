<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pi.tm-daily-status</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/tm-daily-status</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/tm-daily-status.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tm-daily-status.log</string>
</dict>
</plist>
